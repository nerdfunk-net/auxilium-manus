{% if nautobot.config_context is defined and nautobot.config_context.credentials is defined %}
{% set desired = nautobot.config_context.credentials
     | selectattr('username') | selectattr('password') | list %}
{% set desired_names = desired | map(attribute='username') | list %}
{% set device_users = [] %}
{% if parsed is defined and parsed.cisco_config is defined
   and parsed.cisco_config.running is defined
   and parsed.cisco_config.running.identity is defined %}
{% set device_users = parsed.cisco_config.running.identity.users | default([]) %}
{% endif %}
{% for c in desired %}
username {{ c.username }} privilege {{ c.privilege | default(15) }} secret {% if c.level not in [none, ''] %}{{ c.level }} {% endif %}{{ c.password }}
{% endfor %}
{% if desired_names | length > 0 %}
{% for u in device_users %}
{% if u.name not in desired_names %}
no username {{ u.name }}
{% endif %}
{% endfor %}
{% endif %}
{% endif %}