      "data": {
        "kind": "get-age-of-backup",
        "stepUuid": "6749d42f-9a22-4461-801d-21fdc223ab15",
        "title": "Get Age of Backup",
        "overview": "Get how many days ago a device's config backup in git last changed.",
        "description": "Read the date of the newest git commit that touched a device's config backup file and write the age in whole days (plus the date and commit) into a separate attribute bag, so a later step can compare it. A repository only records a commit when the config changed, so this is the age of the last *change*; turn on the backup-check marker to also get the age of the last *check*, taken from a record a Store in DB step wrote after the backup. A device whose backup file is missing or has no commit leaves through failure.\n",
        "artifactType": "configuration_management",
        "requires": [
          "identity"
        ],
        "requiresParsed": [],
        "produces": [
          "attributes"
        ],
        "producesParsed": [],
        "consumes": [],
        "outcomes": [
          {
            "name": "success"
          },
          {
            "name": "failure"
          }
        ],
        "pluginConfig": {
          "git_repository_id": 4,
          "allow_stale_repository": false,
          "path_template": "configs/{nautobot.location.name}/{device.name}.running.cfg",
          "output_bag": "backup_age",
          "use_marker": true,
          "marker_storage_key": "backup_checked"
        },
        "incomeHandleSide": "top",
        "outcomeHandleSide": "bottom"
      },
      "measured": {
        "width": 320,
        "height": 128
      },
      "selected": false,
      "dragging": false
