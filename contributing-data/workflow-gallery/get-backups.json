      "data": {
        "kind": "notify-on-error",
        "stepUuid": "f32ef817-0330-4b1e-a735-7ab538888ef8",
        "title": "Notify On Error",
        "overview": "Write a notification for every accumulated error on every failed device.",
        "description": "Shared error sink for a workflow: wire many upstream steps' failure outcome handles to this one node instead of adding a notify node after every step. Writes one notification row per (device, error) pair — root-cause step id, node id, and message — from that device's accumulated error list, so a device that failed at more than one point before reaching this node still surfaces every failure, not just the latest. Devices with no accumulated errors (e.g. wired to a success handle by mistake) are skipped. Severity is always error. Place this node after the last step whose failures it should catch — branches converge into it before it runs once. Local notification and Mattermost posting (via a configured Mattermost source, team, and channel) are independently toggleable — either or both can be enabled. A Mattermost post failure is logged and does not fail the step or block local notifications.\n",
        "artifactType": "control_flow",
        "requires": [
          "identity"
        ],
        "requiresParsed": [],
        "produces": [],
        "producesParsed": [],
        "consumes": [],
        "outcomes": [
          {
            "name": "success"
          }
        ],
        "pluginConfig": {
          "message": "Device {device.name} failed at {error.step_id} (node {error.node_id}): {error.message}",
          "notify_mattermost": true,
          "mattermost_source_id": "mattermost",
          "team_name": "Manus",
          "channel_name": "manus"
        },
        "incomeHandleSide": "top",
        "outcomeHandleSide": "bottom"
