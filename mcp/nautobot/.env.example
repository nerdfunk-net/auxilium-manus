# Nautobot instance the MCP server reads from.
NAUTOBOT_URL=http://127.0.0.1:8080
# Read-only API token. Never commit a real value.
NAUTOBOT_TOKEN=
NAUTOBOT_VERIFY_SSL=true

# --- HTTP transport (default is stdio; none of the following is read in stdio mode) ---
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# Required when MCP_HOST is not loopback: the Host names clients use, e.g. nautobot-mcp:8000
# MCP_ALLOWED_HOSTS=
# One token per client: name=token, comma separated; each token at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_CLIENT_TOKENS=ui=...
# Or read name=token lines from a file (Docker secret):
# MCP_CLIENT_TOKENS_FILE=/run/secrets/mcp_client_tokens
