# Auxilium Manus agent - copy to .env (Docker: --env-file, systemd: EnvironmentFile) and edit.

# Must equal the "Agent ID" of the agent source in Settings -> Sources -> Agents.
MANUS_AGENT_ID=ip-agent

# Must equal the shared-secret credential selected on that source. At least 32 characters;
# create one with: openssl rand -base64 32
MANUS_AGENT_SECRET=

# --- Transports: set one or both -------------------------------------------------------
# HTTP: the app calls POST http://<this-host>:<port>/v1/invoke (same Docker host / network).
MANUS_AGENT_HTTP_PORT=8080
#MANUS_AGENT_HTTP_HOST=0.0.0.0

# Redis: the agent connects to the app's Redis as its own ACL user (see README.md).
# Use rediss:// (TLS) across networks.
#MANUS_AGENT_REDIS_URL=rediss://agent-ip-agent:<redis-password>@redis.example.com:6379/0

# --- Optional --------------------------------------------------------------------------
#MANUS_AGENT_HANDLERS_DIR=handlers
#MANUS_AGENT_DATA_CONFIG=config.yaml
#MANUS_AGENT_STATE_DIR=state
#MANUS_AGENT_MAX_CONCURRENCY=4
#MANUS_AGENT_MAX_BODY_BYTES=16777216
#MANUS_AGENT_MAX_RESPONSE_BYTES=16777216
#MANUS_AGENT_LOGLEVEL=INFO

# --- Git access (config.yaml: git.auth.token_env) --------------------------------------
#GIT_TOKEN=
