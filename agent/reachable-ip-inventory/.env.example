# Auxilium Manus reachable-ip-inventory agent - copy to .env (Docker: --env-file, systemd: EnvironmentFile) and edit.

# Must equal the "Agent ID" of the agent source in Settings -> Sources -> Agents.
MANUS_AGENT_ID=reachable-agent

# Must equal the shared-secret credential selected on that source. At least 32 characters;
# create one with: openssl rand -base64 32
MANUS_AGENT_SECRET=

# --- Transports: set one or both -------------------------------------------------------
# HTTP: the app calls POST http://<this-host>:<port>/v1/invoke (same Docker host / network).
# 6668, not 8080 (Nautobot); ping-range uses 6667.
MANUS_AGENT_HTTP_PORT=6668
# Address the published port binds to on the Docker host (docker-compose.yml). 127.0.0.1 = this machine only.
#MANUS_AGENT_BIND=127.0.0.1
#MANUS_AGENT_HTTP_HOST=0.0.0.0

# Redis: the agent connects to the app's Redis as its own ACL user (see README.md).
# Use rediss:// (TLS) across networks.
#MANUS_AGENT_REDIS_URL=rediss://agent-reachable-agent:<redis-password>@redis.example.com:6379/0

# --- Nautobot -------------------------------------------------------------------------
# API token for the Nautobot in config.yaml (nautobot.token_env: NAUTOBOT_TOKEN). It needs read access to
# IPAM prefixes. The scan limits (max hosts, allowed networks, fping count/timeout) are in config.yaml.
NAUTOBOT_TOKEN=
# Name of the Docker network Nautobot runs in (`docker network ls`). The agent joins it so that
# nautobot.url in config.yaml can use Nautobot's container name, e.g. http://nautobot:8080.
NAUTOBOT_DOCKER_NETWORK=nautobot_default

# --- Proxy for the image BUILD only (apt and pip) ---------------------------------------
# Read by `docker compose build` / `up --build` and passed to the build as build args. The running container
# does not use a proxy (Docker does not keep these two build args in the image).
#HTTP_PROXY=http://proxy.example.com:3128
#HTTPS_PROXY=http://proxy.example.com:3128

# --- Optional --------------------------------------------------------------------------
#MANUS_AGENT_HANDLERS_DIR=handlers
#MANUS_AGENT_MAX_CONCURRENCY=4
#MANUS_AGENT_MAX_BODY_BYTES=16777216
#MANUS_AGENT_MAX_RESPONSE_BYTES=16777216
#MANUS_AGENT_LOGLEVEL=INFO
