# Copy to .env. Nothing here is required — the Batfish OSS coordinator has no
# authentication, so there's no token/secret to set (see docker-compose.yaml
# for why the ports are bound to 127.0.0.1 only instead).
#
# Optional: pin the image tag for reproducible builds instead of floating on
# `latest`. Check available tags at https://hub.docker.com/r/batfish/allinone/tags.
# Required. Pick a reviewed release tag from https://hub.docker.com/r/batfish/allinone/tags;
# a moving tag (latest) would change the image under you on the next pull.
BATFISH_IMAGE_TAG=
