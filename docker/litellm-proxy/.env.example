# Copy to .env (gitignored) before `docker compose up`.
#
# Key callers (the Auxilium Manus app) must send. Must start with "sk-".
#   echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

# Password of the bundled postgres:17-alpine (user/db: litellm). It is embedded in a URL, so use
# hex/alphanumeric only:  openssl rand -hex 16
# Set before the FIRST start; changing it later does not alter the existing data volume.
LITELLM_DB_PASSWORD=

# Provider credentials, referenced from config.yaml as os.environ/<NAME>.
# Fill in only the providers you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=eu-central-1

# Azure OpenAI
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# Required. A reviewed release tag of ghcr.io/berriai/litellm (no moving tags such as main-stable).
LITELLM_IMAGE_TAG=
