# Standalone Hatchet worker image (optional — compose normally reuses the all-in-one image)
FROM python:3.14.5-slim

WORKDIR /app/backend

RUN apt-get update && apt-get install -y \
    build-essential \
    libffi-dev \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Certs dir (bind-mounted at runtime; INSTALL_CERTIFICATE_FILES installs *.crt from here).
RUN mkdir -p /app/config/certs

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "hatchet.worker"]
