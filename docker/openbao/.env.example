# Copy to .env (gitignored) before `docker compose up`.
#
# Root token for OpenBao DEV MODE (in-memory, local development only). The
# backend / hvac client authenticates with this value. Generate a random one:
#   openssl rand -hex 16
#
# Ignored in persistent mode (`bao operator init` issues the root token there).
OPENBAO_DEV_ROOT_TOKEN=
