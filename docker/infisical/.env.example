# Copy to .env (gitignored) before `docker compose up`.
#
# Required keys for a self-hosted Infisical instance. Generate them once and
# keep them: ENCRYPTION_KEY cannot be rotated without losing access to every
# stored secret (even after restoring the Postgres volume).
#
#   ENCRYPTION_KEY=$(openssl rand -hex 16)
#   AUTH_SECRET=$(openssl rand -base64 32)
#   POSTGRES_PASSWORD=$(openssl rand -hex 16)
#
# POSTGRES_PASSWORD is interpolated into DB_CONNECTION_URI — avoid `@`, `:`,
# `/`, `?`, `#`, and `%` in the value.

ENCRYPTION_KEY=
AUTH_SECRET=

POSTGRES_USER=infisical
POSTGRES_PASSWORD=
POSTGRES_DB=infisical

# Browser-facing origin of this Infisical UI (cookies / CORS). Must match how
# you open it. Default compose publishes 127.0.0.1:8080.
SITE_URL=http://localhost:8080

# Optional: pin the image instead of floating on `latest`.
# Check tags at https://hub.docker.com/r/infisical/infisical/tags
# INFISICAL_IMAGE_TAG=v0.165.10
