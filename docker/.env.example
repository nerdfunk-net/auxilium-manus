# Auxilium Manus — Docker Compose secrets and overrides.
#
#   cp .env.example .env
#   # then fill in every REQUIRED value below
#   docker compose up -d
#
# This file is read by docker-compose.yml only — it has no effect on running
# the backend/frontend directly (see backend/.env.example for that). Values
# left unset here fail `docker compose up` with a clear message for anything
# required; everything else falls back to the default shown.

# --- REQUIRED ---------------------------------------------------------

# JWT signing key. Generate with: openssl rand -hex 32
SECRET_KEY=

# Password for the seeded admin user, 12+ characters. The admin is forced to
# change it on first login regardless, but the guard below rejects a short
# value outright — see backend/core/production_guards.py.
INITIAL_PASSWORD=

# Encrypts stored credentials (device SSH keys, source tokens, etc.) at
# rest. Must differ from SECRET_KEY. Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=

# Proxy addresses (IP or CIDR, comma-separated) allowed to set X-Forwarded-For. all-in-one: 127.0.0.1
# TRUSTED_PROXY_IPS=127.0.0.1

# PostgreSQL passwords. The application connects as the unprivileged role "manus"
# (DATABASE_PASSWORD, created on the first start of the data volume by
# docker/postgres-init); the superuser password never reaches the app containers.
# Use different values, at least 12 characters each (openssl rand -hex 24).
DATABASE_PASSWORD=
POSTGRES_PASSWORD=

# Redis password (shared by the manus-redis service and the app containers'
# MANUS_REDIS_PASSWORD).
MANUS_REDIS_PASSWORD=

# Hatchet API token. Start the Hatchet stack first (see docker/README.md), change the
# dashboard admin password, then create a token at the dashboard (Settings → API Tokens).
HATCHET_CLIENT_TOKEN=

# --- OPTIONAL (sensible defaults; override only if you need to) -------

# development | production. Affects the production secret/config guards in
# backend/core/production_guards.py — see docker-compose.dev.yml for the
# usual way to run a development stack instead of editing this.
# ENV=production

# Enable /docs (Swagger) and /redoc.
# DOCS_ENABLED=false

# Username for the seeded admin user.
# INITIAL_USERNAME=admin

# Install config/certs/*.crt (repo-root config/, bind-mounted into every
# container) into the system trust store on startup — for a private/
# internal CA in front of Nautobot, OIDC, or other integrations.
# INSTALL_CERTIFICATE_FILES=false

# --- OPTIONAL: settings that reach the containers (defaults shown) ------

# How the web container is published on the host. Default: loopback only. Put your TLS
# ingress on this host, or attach it to the compose network and route to http://manus-web:3000.
# The backend port 8000 is never published.
# MANUS_WEB_PUBLISH=127.0.0.1:3000

# Exact OIDC redirect URIs, comma separated (required when SSO is used). Client secrets go
# into docker/oidc.env (see oidc.env.example).
# OIDC_REDIRECT_URI_ALLOWLIST=

# Absolute session lifetime and refresh window (hours), and the request body limit (bytes).
# SESSION_MAX_AGE_HOURS=12
# REFRESH_TOKEN_MAX_AGE_HOURS=12
# MAX_REQUEST_BODY_BYTES=26214400

# AI assistant (operator limits; off by default - the assistant does not exist until you enable it).
# AI_ALLOWED_PROVIDERS: anthropic, gemini, openai_compat.
# AI_ALLOWED_DATA: inventory, addresses, custom_fields, config_context, content, report.
# AI_ASSISTANT_ENABLED=false
# AI_ALLOWED_PROVIDERS=
# AI_ALLOWED_DATA=

# Memory limit per application container (compose mem_limit syntax).
# MANUS_MEM_LIMIT=4g

# Retention. 0 keeps everything for the two day-count settings.
# AI_CONVERSATION_RETENTION_DAYS=90
# REPORT_DATA_RETENTION_DAYS=365
# RUN_RETENTION_ENABLED=true
# RUN_RETENTION_DAYS=90
# RUN_RETENTION_BATCH_SIZE=500
# RUN_RETENTION_CRON_SCHEDULE=0 3 * * *
# Reaper: finalises runs stuck active after a lost worker or timeout
# RUN_REAPER_CRON_SCHEDULE=*/10 * * * *
# RUN_REAPER_GRACE_MINUTES=15

# Persisted step output cap (the live context is not capped)
# STEP_OUTPUT_VALUE_MAX_BYTES=65536
# STEP_OUTPUT_MAX_BYTES=8388608

# Database pool (web default 10 + 10 overflow; workers 20 + 20)
# DATABASE_POOL_SIZE=
# DATABASE_MAX_OVERFLOW=
# DATABASE_POOL_TIMEOUT=30

# Local model servers on loopback (AI base URL, see DOCKER.md). Off by default.
# ALLOW_LOOPBACK_SOURCE_URLS=false

# Redis outage and login: false = in-process rate limits keep login working (default); true = refuse.
# RATE_LIMIT_FAIL_CLOSED=false
# Git steps need their Redis lock (fail with a retryable error when Redis is down). false = run unlocked.
# GIT_REPO_LOCK_REQUIRED=true

# Hatchet REST API address as seen from the containers (default: the dashboard container).
# HATCHET_CLIENT_SERVER_URL=http://hatchet-dashboard:8080

# Switch to a TLS strategy once the Hatchet engine serves gRPC over TLS.
# HATCHET_CLIENT_TLS_STRATEGY=none

# Netmiko session pooling and the file extensions the file API may serve.
# NETMIKO_SESSION_POOLING=true
# NETMIKO_POOL_WORKERS=10
# NETMIKO_KEEPALIVE_SECONDS=30
# ALLOWED_FILE_EXTENSIONS=.cfg,.conf,.txt,.yaml,.yml,.json,.xml,.ini,.md
