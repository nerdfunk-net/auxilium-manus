# Auxilium Manus — Docker Compose secrets and overrides.
#
#   cp .env.example .env
#   # then fill in every REQUIRED value below
#   docker compose up -d
#
# This file is read by docker-compose.yml only — it has no effect on running
# the backend/frontend directly (see backend/.env.example for that). Values
# left unset here fail `docker compose up` with a clear message for anything
# required; everything else falls back to the default shown.

# --- REQUIRED ---------------------------------------------------------

# JWT signing key. Generate with: openssl rand -hex 32
SECRET_KEY=

# Password for the seeded admin user, 12+ characters. The admin is forced to
# change it on first login regardless, but the guard below rejects a short
# value outright — see backend/core/production_guards.py.
INITIAL_PASSWORD=

# Encrypts stored credentials (device SSH keys, source tokens, etc.) at
# rest. Must differ from SECRET_KEY. Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=

# PostgreSQL password (shared by the manus-postgres service and the app
# containers' DATABASE_PASSWORD).
DATABASE_PASSWORD=

# Redis password (shared by the manus-redis service and the app containers'
# MANUS_REDIS_PASSWORD).
MANUS_REDIS_PASSWORD=

# Hatchet API token. Start the Hatchet stack first (see docker/README.md),
# then create one at http://localhost:8888 → Settings → API Tokens.
HATCHET_CLIENT_TOKEN=

# --- OPTIONAL (sensible defaults; override only if you need to) -------

# development | production. Affects the production secret/config guards in
# backend/core/production_guards.py — see docker-compose.dev.yml for the
# usual way to run a development stack instead of editing this.
# ENV=production

# Enable /docs (Swagger) and /redoc.
# DOCS_ENABLED=false

# Username for the seeded admin user.
# INITIAL_USERNAME=admin

# Install config/certs/*.crt (repo-root config/, bind-mounted into every
# container) into the system trust store on startup — for a private/
# internal CA in front of Nautobot, OIDC, or other integrations.
# INSTALL_CERTIFICATE_FILES=false
