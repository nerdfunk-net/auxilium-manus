ENV=development
# JWT signing key. Must be overridden (not the default) outside development.
SECRET_KEY=change-in-production-use-at-least-32-characters
# Minutes an access token stays valid before it must be refreshed
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Hours a refresh token/session stays valid before re-authentication is required
REFRESH_TOKEN_MAX_AGE_HOURS=24
# Enable /docs (Swagger) and /redoc (default: true in development, false otherwise)
DOCS_ENABLED=true
# Comma-separated IPs trusted to set X-Forwarded-For (empty = trust none)
TRUSTED_PROXY_IPS=

# Uvicorn bind address (used by start.py)
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8001

# PostgreSQL connection (single application database, see doc/MIGRATION_SYSTEM.md)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=manus
# Maintenance-connection database (used to create/check DATABASE_NAME itself)
DATABASE_MAINTENANCE_NAME=postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
# Optional: full connection URL overrides (built from the fields above if unset)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/manus
# MAINTENANCE_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres

# Optional: path to the workflow step plugin registry (default: workflow_steps/registry.yaml)
# PLUGINS_FILE=

# Bootstrap admin account, created on first startup if no users exist
INITIAL_USERNAME=admin
INITIAL_PASSWORD=admin

# Credential vault (SSH logins — encrypted at rest in PostgreSQL). Also used to seal
# secret-valued workflow attributes (e.g. TACACS+ shared secrets — see "Secret-valued
# attributes" in doc/WORKFLOW-STEPS.md) while they ride in a run's workflow context.
# Dedicated key is recommended in production; falls back to SECRET_KEY if unset.
# Rotating this key invalidates any already-sealed secret (stored credential or
# in-flight workflow secret) that was encrypted under the old value.
CREDENTIAL_ENCRYPTION_KEY=
# Writable directory for exported SSH key files (default: <project-root>/data)
# DATA_DIRECTORY=
# Optional: PBKDF2 iterations for credential encryption (default: 100000)
# KDF_ITERATIONS=100000

# Redis (Nautobot device bulk cache)
MANUS_REDIS_HOST=localhost
MANUS_REDIS_PORT=6379
MANUS_REDIS_PASSWORD=changeme
# Optional overrides:
# MANUS_REDIS_URL=redis://:changeme@localhost:6379/0
# MANUS_REDIS_KEY_PREFIX=manus-cache

# Hatchet workflow engine (docker/hatchet/docker-compose.yml). All HATCHET_CLIENT_*
# vars are read directly by the hatchet-sdk (backend/hatchet/client.py) — there is
# no app-side override, so these are the only place to configure it. See
# Settings → Hatchet in the UI for a read-only view of what actually got resolved.
# Get token: docker compose up -d, then http://localhost:8888 → Settings → API Tokens
HATCHET_CLIENT_TOKEN=<paste token here>
# gRPC engine address used to dispatch workflow runs (hatchet-engine, port 7077 on host)
HATCHET_CLIENT_HOST_PORT=localhost:7077
# REST API base URL (hatchet-dashboard, port 8888 on host) — used for cron/scheduled
# triggers, run cancellation, and listing. Overrides the token's embedded server_url
# claim, which can go stale if the token was issued while Hatchet ran on a different
# port/host than it does now.
HATCHET_CLIENT_SERVER_URL=http://localhost:8888
# Optional: browser-reachable URL for the "Open Dashboard" link in Settings →
# Hatchet. Only needed when HATCHET_CLIENT_SERVER_URL is a network-internal
# address (e.g. a Docker service name behind Traefik) that the backend can
# reach but a browser cannot. Defaults to HATCHET_CLIENT_SERVER_URL when unset.
# HATCHET_DASHBOARD_URL=https://hatchet.example.com
# none | tls | mtls (see hatchet_sdk ClientTLSConfig) — "none" for local docker compose
HATCHET_CLIENT_TLS_STRATEGY=none
# Verbose Hatchet SDK logging
HATCHET_CLIENT_DEBUG=true
# Live worker identity (shown in the Hatchet dashboard) and capacity (max
# concurrent step/task runs this worker process executes at once, across all
# unpublished workflows). Read by backend/hatchet/worker_config.py; requires
# restarting the worker process to take effect. Tune worker slots based on
# box size and workload.
HATCHET_WORKER_NAME=auxilium-manus-live-worker
HATCHET_WORKER_SLOTS=10

# Background worker (backend/hatchet/dynamic_worker.py) — hosts workflows
# published to the background tier, each with its own Hatchet-native
# concurrency limit; see doc/ARCHITECTURAL_OVERVIEW.md "Background-tier
# workflows". Read by backend/hatchet/dynamic_worker_config.py. POLL_INTERVAL
# controls how quickly a publish/unpublish/edit propagates (the worker
# restarts itself to pick it up).
HATCHET_DYNAMIC_WORKER_NAME=auxilium-manus-background-worker
HATCHET_DYNAMIC_WORKER_SLOTS=10
HATCHET_DYNAMIC_WORKER_POLL_INTERVAL_SECONDS=30

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# Rotating log files written alongside stdout (default: <data_directory>/logs)
# LOG_DIRECTORY=
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5

# Workflow run retention (scripts/purge_retention.py — schedule via cron)
RUN_RETENTION_ENABLED=false
RUN_RETENTION_DAYS=90
RUN_RETENTION_BATCH_SIZE=500

# Database schema sync (see doc/MIGRATION_SYSTEM.md). Structural changes (new
# tables/columns/indexes) always apply on startup; these gate column type/nullable changes.
APPLY_SAFE_DATABASE_MIGRATION=false
APPLY_RISKY_DATABASE_MIGRATION=false

# Install CA certificates from config/certs/*.crt into the system trust store on startup
# (Docker only — requires update-ca-certificates; no-op on macOS/local dev). See /tools.
INSTALL_CERTIFICATE_FILES=false

# Allow ISE/Nautobot source URLs that resolve to loopback (127.0.0.0/8, ::1).
# Default false; set true only for local lab setups.
ALLOW_LOOPBACK_SOURCE_URLS=false

# Netmiko durable SSH sessions (see doc/DURABLE_SSH_SESSION.md)
# Reuse one SSH session per device across steps in a run instead of reconnecting each time
NETMIKO_SESSION_POOLING=true
# Max concurrent pooled SSH sessions
NETMIKO_POOL_WORKERS=10
# Idle seconds before a pooled session sends a keepalive
NETMIKO_KEEPALIVE_SECONDS=30
