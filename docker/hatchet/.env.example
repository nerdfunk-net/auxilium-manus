# Hatchet stack secrets: cp .env.example .env and fill in. Generate each with: openssl rand -hex 24
# (hex keeps the value safe inside the connection URLs).
HATCHET_DB_PASSWORD=
HATCHET_RABBITMQ_PASSWORD=
# Host:port the browser uses for the dashboard (cookie domain). Production: your dashboard host name.
HATCHET_COOKIE_DOMAIN=localhost:8888
# Dashboard login (seeded the first time the stack is set up). Use your own address and a strong
# password; there is deliberately no default. Hatchet rejects a weaker one and the setup container
# then exits with an error: 8-64 characters with at least one upper-case letter, one lower-case
# letter and one digit. (`openssl rand -hex` alone has no upper-case letter; prefix it, for example
# "Aa1-$(openssl rand -hex 12)".) After a failed first start run `docker compose down -v` before retrying.
HATCHET_ADMIN_EMAIL=
HATCHET_ADMIN_PASSWORD=
